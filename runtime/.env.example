POSTGRES_DB=araru
POSTGRES_USER=araru
POSTGRES_PASSWORD=change-this-password

# Relative to runtime/docker-compose.yml. For sibling checkouts use ../..;
# for components inside the central checkout use .. and runtime/Dockerfile.
ARARU_WORKSPACE_ROOT=../..
ARARU_RUNTIME_DOCKERFILE=araruoss/runtime/Dockerfile

# Server e Web possuem ciclos de release independentes.
ARARU_SERVER_VERSION=local
ARARU_WEB_VERSION=local
ARARU_SERVER_PORT=3001
ARARU_WEB_PORT=8080
PUBLIC_WEB_URL=http://localhost:8080
PUBLIC_BACKEND_URL=http://localhost:3001

SECURE_COOKIES=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
RATE_LIMIT_ENABLED=false
ENABLE_GOOGLE_DRIVE=false
APP_ACCESS_SECRET=
CSP_CONNECT_SRC=
